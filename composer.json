{
    "name": "oi-lab/oi-laravel-geo",
    "description": "A Laravel package for geographic data management with hierarchical models (City, Department, Region, Country)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OI Lab",
            "email": "contact@oi-lab.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/console": "^11.0|^12.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "orchestra/testbench": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "OiLab\\OiLaravelGeo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OiLab\\OiLaravelGeo\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OiLab\\OiLaravelGeo\\OiLaravelGeoServiceProvider"
            ],
            "aliases": {
                "OiLaravelGeo": "OiLab\\OiLaravelGeo\\Facades\\OiLaravelGeo"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
